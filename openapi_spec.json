{
  "openapi": "3.1.0",
  "info": {
    "title": "Intraclass Correlation Calculator API",
    "description": "ICC point estimates plus separate experimental audit endpoints. The runtime /openapi.json is authoritative.",
    "version": "3.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Service health",
        "responses": {
          "200": {
            "description": "Health and version"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Basic JSON runtime counters",
        "responses": {
          "200": {
            "description": "Operational counters and audit integrity status"
          }
        }
      }
    },
    "/api/icc": {
      "post": {
        "summary": "Compute balanced-design ICCs from subject-by-rater ratings",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "ratings"
                ],
                "properties": {
                  "ratings": {
                    "type": "array",
                    "minItems": 2,
                    "items": {
                      "type": "array",
                      "minItems": 2,
                      "items": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Six ICC point estimates and ANOVA mean squares"
          },
          "422": {
            "description": "Missing, nonnumeric, unbalanced, or otherwise invalid ratings"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Experimental audit worker evaluation (not an ICC calculation)",
        "responses": {
          "200": {
            "description": "Audit dossier"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Mock supervisory chat response",
        "responses": {
          "200": {
            "description": "Mock reply"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "In-memory signed audit records",
        "responses": {
          "200": {
            "description": "Audit trail and signature verification status"
          }
        }
      }
    }
  }
}
